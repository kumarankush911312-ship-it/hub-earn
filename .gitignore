{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hub-earn",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hub-earn",
      "database_id": "local-dev"
    }
  ]
}
