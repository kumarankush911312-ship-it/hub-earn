export interface RewardPayload {
  title: string;
  description: string;
  points: number;
  status: 'available' | 'pending' | 'claimed';
}

interface Env {
  DB: D1Database;
}

const fallbackRewards = [
  {
    id: 'seed-1',
    title: 'Spring Launch Bonus',
    description: 'Earned for completing the Q2 launch checklist.',
    points: 250,
    status: 'available',
    createdAt: new Date('2026-09-02T09:00:00.000Z').toISOString(),
  },
  {
    id: 'seed-2',
    title: 'Referral Milestone',
    description: 'Rewards for bringing in three new active users.',
    points: 180,
    status: 'pending',
    createdAt: new Date('2026-09-16T10:15:00.000Z').toISOString(),
  },
  {
    id: 'seed-3',
    title: 'Cloud Credit Rebate',
    description: 'Automated rebate for spending over the monthly tier.',
    points: 450,
    status: 'claimed',
    createdAt: new Date('2026-09-21T13:05:00.000Z').toISOString(),
  },
];

function jsonResponse(data: unknown, init?: ResponseInit) {
  return new Response(JSON.stringify(data), {
    ...init,
    headers: {
      'Content-Type': 'application/json',
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
      'Access-Control-Allow-Headers': 'Content-Type',
      ...(init?.headers ?? {}),
    },
  });
}

export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    if (request.method === 'OPTIONS') {
      return new Response(null, { status: 204, headers: { 'Access-Control-Allow-Origin': '*' } });
    }

    const url = new URL(request.url);

    if (url.pathname === '/api/health') {
      return jsonResponse({ status: 'ok', database: 'ready' });
    }

    if (url.pathname === '/api/rewards') {
      if (request.method === 'GET') {
        try {
          const rows = await env.DB.prepare(
            'SELECT id, title, description, points, status, created_at as createdAt FROM rewards ORDER BY created_at DESC LIMIT 20',
          ).all();

          const rewards = rows.results.map((row) => ({
            id: row.id as string,
            title: row.title as string,
            description: row.description as string,
            points: Number(row.points),
            status: (row.status as string) || 'pending',
            createdAt: row.createdAt as string,
          }));

          return jsonResponse(rewards.length > 0 ? rewards : fallbackRewards);
        } catch (error) {
          console.error('Failed to read rewards from D1:', error);
          return jsonResponse(fallbackRewards);
        }
      }

      if (request.method === 'POST') {
        try {
          const payload = (await request.json()) as Partial<RewardPayload>;
          const title = (payload.title ?? '').toString().trim();
          const description = (payload.description ?? 'Reward created from dashboard').toString().trim();
          const points = Number(payload.points ?? 100);
          const status = (payload.status ?? 'pending') as RewardPayload['status'];

          if (!title) {
            return jsonResponse({ error: 'Reward title is required.' }, { status: 400 });
          }

          const id = crypto.randomUUID();
          const createdAt = new Date().toISOString();

          await env.DB.prepare(
            'INSERT INTO rewards (id, title, description, points, status, created_at) VALUES (?, ?, ?, ?, ?, ?)',
          )
            .bind(id, title, description, points, status, createdAt)
            .run();

          return jsonResponse({ id, title, description, points, status, createdAt }, { status: 201 });
        } catch (error) {
          console.error('Failed to save reward:', error);
          return jsonResponse({ error: 'Unable to create reward.' }, { status: 500 });
        }
      }
    }

    try {
      await env.DB.prepare(`
        CREATE TABLE IF NOT EXISTS rewards (
          id TEXT PRIMARY KEY,
          title TEXT NOT NULL,
          description TEXT NOT NULL,
          points INTEGER NOT NULL,
          status TEXT NOT NULL,
          created_at TEXT NOT NULL
        )
      `).run();
    } catch (error) {
      console.warn('Database initialization skipped:', error);
    }

    return jsonResponse({ message: 'Not found' }, { status: 404 });
  },
};
